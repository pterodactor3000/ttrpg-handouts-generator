---
import Layout from '@/layouts/Layout.astro';
import { Card, CardContent } from '@/components/atoms/card';

export const prerender = false;

Astro.response.status = 404;
---

<Layout title="Handout not found">
  <main
    class="bg-background text-foreground flex min-h-screen w-full flex-col items-center justify-center px-4 text-center"
  >
    <Card className="border-border bg-card text-foreground mx-auto w-full max-w-md gap-0 border py-0 shadow-none">
      <CardContent className="p-8">
        <h1 class="mb-3 text-2xl font-bold">Handout not found</h1>
        <p class="text-muted-foreground text-sm">This link may be invalid or the handout has not been shared yet.</p>
        <a
          href="/"
          class="border-border bg-card text-foreground hover:bg-accent mt-6 inline-block rounded-lg border px-4 py-2 text-sm transition-colors"
        >
          Back to home
        </a>
      </CardContent>
    </Card>
  </main>
</Layout>
