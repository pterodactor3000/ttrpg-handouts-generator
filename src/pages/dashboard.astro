---
import * as Sentry from '@sentry/cloudflare';
import Layout from '@/layouts/Layout.astro';
import HandoutList from '@/components/organisms/HandoutList.astro';
import DashboardDrawer from '@/components/organisms/DashboardDrawer';
import { Card, CardContent } from '@/components/atoms/card';
import { createClient } from '@/lib/supabase';
import { groupHandoutsByStatus, type HandoutListItem } from '@/lib/handout-list';

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let isConfigured = true;
let hasLoadError = false;
let draftHandouts: HandoutListItem[] = [];
let publishedHandouts: HandoutListItem[] = [];
let archivedHandouts: HandoutListItem[] = [];

if (!supabase) {
  isConfigured = false;
} else {
  const { data, error } = await supabase
    .from('handouts')
    .select('id, title, tags, status, background_category, share_token, created_at')
    .order('created_at', { ascending: false });

  if (error) {
    console.error('DB error loading handouts:', error);
    Sentry.captureException(error);
    hasLoadError = true;
  } else {
    const handouts = data as HandoutListItem[];
    const groupedHandouts = groupHandoutsByStatus(handouts);
    draftHandouts = groupedHandouts.draft;
    publishedHandouts = groupedHandouts.published;
    archivedHandouts = groupedHandouts.archived;
  }
}
---

<Layout title="Dashboard" loadChromeFont>
  <div class="moon-chrome bg-background text-foreground flex min-h-screen flex-col">
    {
      !isConfigured ? (
        <div class="mx-auto w-full max-w-6xl p-4 md:p-8">
          <Card className="border-border bg-card text-foreground gap-0 border py-0 text-center shadow-sm">
            <CardContent className="p-8">
              <h1 class="mb-3 text-2xl font-bold">Dashboard temporarily unavailable</h1>
              <p class="text-muted-foreground text-sm">Please try again later.</p>
            </CardContent>
          </Card>
        </div>
      ) : hasLoadError ? (
        <div class="mx-auto w-full max-w-6xl p-4 md:p-8">
          <Card className="border-border bg-card text-foreground gap-0 border py-0 text-center shadow-sm">
            <CardContent className="p-8">
              <h1 class="mb-3 text-2xl font-bold">Could not load handouts</h1>
              <p class="text-muted-foreground text-sm">
                Something went wrong while loading your handouts. Please try again later.
              </p>
            </CardContent>
          </Card>
        </div>
      ) : (
        <div data-dashboard data-status-filter="draft" class="flex min-h-screen w-full items-stretch">
          <div
            data-dashboard-drawer-slot
            class="w-0 shrink-0 transition-[width] duration-300 ease-out motion-reduce:transition-none md:w-64"
          />
          <div class="min-w-0 flex-1 p-4 md:p-8">
            <div class="mx-auto w-full max-w-6xl">
              <Card className="border-border bg-card text-foreground gap-0 border py-0 shadow-sm">
                <CardContent className="p-6">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <div class="flex items-center gap-2">
                        <DashboardDrawer client:load />
                        <h1 class="text-foreground text-3xl font-bold tracking-tight">Dashboard</h1>
                      </div>
                      <p class="text-muted-foreground mt-1">
                        Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
                      </p>
                    </div>
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                      <a
                        href="/handouts/new"
                        data-slot="button"
                        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-[0.5rem] px-4 py-2 text-center text-sm font-semibold transition-colors"
                      >
                        + New handout
                      </a>
                      <form method="POST" action="/api/auth/signout">
                        <button
                          type="submit"
                          data-slot="button"
                          class="border-border bg-card hover:bg-accent w-full rounded-[0.5rem] border px-4 py-2 text-sm font-semibold transition-colors sm:w-auto"
                        >
                          Sign out
                        </button>
                      </form>
                    </div>
                  </div>
                </CardContent>
              </Card>

              <HandoutList heading="Drafts" handouts={draftHandouts} listKind="draft" />
              <HandoutList heading="Published" handouts={publishedHandouts} listKind="published" />
              <HandoutList heading="Archived" handouts={archivedHandouts} listKind="archived" />
            </div>
          </div>
        </div>
      )
    }
  </div>
</Layout>
