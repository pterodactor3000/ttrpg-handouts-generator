---
import StatusBadge from '@/components/atoms/StatusBadge.astro';
import { HandoutTagRow } from '@/components/molecules/HandoutTagRow';
import ArchiveButton from '@/components/atoms/ArchiveButton';
import CopyLinkButton from '@/components/atoms/CopyLinkButton';
import DeleteHandoutButton from '@/components/atoms/DeleteHandoutButton';
import RestoreHandoutButton from '@/components/atoms/RestoreHandoutButton';
import { BACKGROUND_CONFIGS, getHandoutStripImageUrl } from '@/lib/backgrounds';
import type { HandoutListItem } from '@/lib/handout-list';
import type { BackgroundCategory } from '@/types';

interface Props {
  handout: HandoutListItem;
}

const { handout } = Astro.props;
const backgroundConfig = BACKGROUND_CONFIGS[handout.background_category];
const hasShareLink = handout.share_token != null;
const stripImageUrl = getHandoutStripImageUrl(handout.background_category);

function getStripImageCrop(category: BackgroundCategory): { size: string; position: string } {
  switch (category) {
    case 'fantasy':
      // 833x839. The 80px border-image slice fills the 48px strip.
      return { size: '100% calc(48px * 839 / 80)', position: 'top center' };
    case 'horror':
      // 366x366. Rows 0-36 are cream. Show source rows 36-80, the ornament inside the 80px slice.
      return { size: '100% calc(48px * 366 / 44)', position: 'center calc(-36px * 48 / 44)' };
    case 'scifi':
      // 256x256. The 60px border-image slice fills the 48px strip.
      return { size: '100% calc(48px * 256 / 60)', position: 'top center' };
  }
}

const stripImageCrop = getStripImageCrop(handout.background_category);
const stripStyle = [
  'background-color: transparent',
  `background-image: linear-gradient(to bottom, transparent 35%, var(--card)), url('${stripImageUrl}')`,
  'background-repeat: no-repeat, no-repeat',
  `background-size: 100% 100%, ${stripImageCrop.size}`,
  `background-position: center, ${stripImageCrop.position}`,
  'box-shadow: inset 0 -1rem 0.85rem var(--card)',
].join('; ');
---

<!--
  Keep a semantic article so archive and delete helpers can use .closest('article').
-->
<article class="flex h-64 w-full min-w-0 flex-col overflow-hidden" data-handout-card>
  <div
    class="h-12 w-full shrink-0 overflow-hidden"
    style={stripStyle}
    title={backgroundConfig.label}
    aria-hidden="true"
  >
  </div>
  <div class="bg-card flex min-h-0 flex-1 flex-col p-4" data-handout-card-body>
    <div class="mb-2 flex shrink-0 items-center justify-between gap-2">
      {
        handout.share_token ? (
          <a
            href={`/share/${handout.share_token}`}
            target="_blank"
            title={handout.title}
            data-handout-title
            class="text-foreground hover:text-primary min-w-0 flex-1 truncate text-lg font-semibold transition-colors"
          >
            {handout.title}
          </a>
        ) : (
          <h3
            class="text-foreground min-w-0 flex-1 truncate text-lg font-semibold"
            title={handout.title}
            data-handout-title
          >
            {handout.title}
          </h3>
        )
      }
      <StatusBadge status={handout.status} />
    </div>
    <p class="text-muted-foreground mb-3 shrink-0 text-xs">{backgroundConfig.label}</p>
    {handout.tags.length > 0 && <HandoutTagRow client:idle tags={handout.tags} handoutTitle={handout.title} />}
    <div
      class="border-border mt-auto flex shrink-0 items-center justify-between gap-2 border-t pt-3"
      data-handout-card-footer
    >
      <div class="flex items-center gap-2">
        <span data-handout-edit-action class:list={[handout.status === 'archived' && 'hidden']}>
          <a
            href={`/handouts/${handout.id}/edit`}
            class="border-border bg-background text-muted-foreground hover:bg-accent hover:text-foreground inline-flex items-center rounded-[0.5rem] border px-3 py-1.5 text-sm transition-colors"
            data-slot="button"
          >
            Edit
          </a>
        </span>
        <span data-handout-archive-action class:list={[handout.status === 'archived' && 'hidden']}>
          <ArchiveButton handoutId={handout.id} handoutTitle={handout.title} client:idle />
        </span>
        <span data-handout-delete-action class:list={[handout.status !== 'archived' && 'hidden']}>
          <DeleteHandoutButton
            handoutId={handout.id}
            handoutTitle={handout.title}
            hasShareLink={hasShareLink}
            client:idle
          />
        </span>
        {
          handout.status === 'archived' && (
            <span data-handout-restore-action>
              <RestoreHandoutButton handoutId={handout.id} handoutTitle={handout.title} client:idle />
            </span>
          )
        }
      </div>
      {
        handout.share_token && handout.status !== 'draft' && (
          <span data-handout-copy-action>
            <CopyLinkButton shareToken={handout.share_token} client:idle />
          </span>
        )
      }
    </div>
  </div>
</article>

<style>
  /* Moon chrome paints and outlines every article. Keep that fill and border on the block under the strip only. */
  :global(.moon-chrome) article[data-handout-card] {
    background-color: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  :global(.moon-chrome) article[data-handout-card] > [data-handout-card-body] {
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 0.75rem 0.75rem;
    box-shadow: 0 6px 6px -6px rgb(0 0 0 / 0.16);
  }
</style>
