---
import StatusBadge from '@/components/atoms/StatusBadge.astro';
import ArchiveButton from '@/components/atoms/ArchiveButton';
import CopyLinkButton from '@/components/atoms/CopyLinkButton';
import DeleteHandoutButton from '@/components/atoms/DeleteHandoutButton';
import { BACKGROUND_CONFIGS } from '@/lib/backgrounds';
import type { HandoutListItem } from '@/lib/handout-list';

interface Props {
  handout: HandoutListItem;
}

const { handout } = Astro.props;
const backgroundConfig = BACKGROUND_CONFIGS[handout.background_category];
const hasShareLink = handout.share_token != null;
---

<!--
  Card has no asChild, so keep semantic <article> for archive/delete DOM helpers
  (.closest('article')). Radius stays token-linked via rounded-xl (Phase 1 zeroed
  --radius-xl). Plan Phase 3 HandoutCard "otherwise" path.
-->
<article class="border-surface bg-surface w-full min-w-0 overflow-hidden rounded-xl border backdrop-blur-xl">
  <div
    class="h-12 w-full"
    style={`background: ${backgroundConfig.cssBackground}; background-size: cover; background-position: center`}
    title={backgroundConfig.label}
    aria-hidden="true"
  >
  </div>
  <div class="p-4">
    <div class="mb-2 flex items-start justify-between gap-2">
      {
        handout.share_token ? (
          <a
            href={`/share/${handout.share_token}`}
            target="_blank"
            class="hover:text-brand-accent-light text-foreground min-w-0 flex-1 text-lg font-semibold break-words transition-colors"
          >
            {handout.title}
          </a>
        ) : (
          <h3 class="text-foreground min-w-0 flex-1 text-lg font-semibold break-words">{handout.title}</h3>
        )
      }
      <StatusBadge status={handout.status} />
    </div>
    <p class="text-muted-foreground mb-3 text-xs">{backgroundConfig.label}</p>
    {
      handout.tags.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2">
          {handout.tags.map((tag) => (
            <span class="border-surface bg-surface text-foreground rounded-none border px-3 py-1 text-sm">{tag}</span>
          ))}
        </div>
      )
    }
    <div class="border-surface flex items-center justify-between gap-2 border-t pt-3" data-handout-card-footer>
      <div class="flex items-center gap-2">
        {
          handout.status !== 'archived' && (
            <span data-handout-edit-action>
              <a
                href={`/handouts/${handout.id}/edit`}
                class="border-surface bg-surface text-muted-foreground hover:bg-accent hover:text-foreground inline-flex items-center rounded-md border px-3 py-1.5 text-sm transition-colors"
              >
                Edit
              </a>
            </span>
          )
        }
        <span data-handout-archive-action class:list={[handout.status === 'archived' && 'hidden']}>
          <ArchiveButton handoutId={handout.id} handoutTitle={handout.title} client:idle />
        </span>
        <span data-handout-delete-action class:list={[handout.status !== 'archived' && 'hidden']}>
          <DeleteHandoutButton
            handoutId={handout.id}
            handoutTitle={handout.title}
            hasShareLink={hasShareLink}
            client:idle
          />
        </span>
      </div>
      {handout.share_token && <CopyLinkButton shareToken={handout.share_token} client:idle />}
    </div>
  </div>
</article>
