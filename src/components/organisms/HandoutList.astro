---
import HandoutCard from '@/components/molecules/HandoutCard.astro';
import type { HandoutListItem } from '@/lib/handout-list';

interface Props {
  heading: string;
  handouts: HandoutListItem[];
  listKind: 'draft' | 'published' | 'archived';
}

const { heading, handouts, listKind } = Astro.props;
const isHidden = listKind !== 'draft';
---

<section class="mt-8 w-full min-w-0" data-handout-list={listKind} hidden={isHidden}>
  <h2 class="mb-4">
    <button
      type="button"
      class="text-foreground w-full cursor-pointer text-left text-xl font-semibold"
      data-handout-list-toggle
      aria-expanded="true"
      aria-controls={`handout-list-body-${listKind}`}
    >
      {heading}
    </button>
  </h2>
  <div id={`handout-list-body-${listKind}`} data-handout-list-body>
    <div class="grid w-full min-w-0 grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-handout-grid={listKind}>
      {handouts.map((handout) => <HandoutCard handout={handout} />)}
    </div>
    <div data-handout-empty>
      {
        listKind === 'draft' ? (
          <>
            <p class="text-muted-foreground">No drafts.</p>
            <a
              href="/handouts/new"
              data-slot="button"
              class="bg-primary text-primary-foreground hover:bg-primary/90 mt-4 inline-block rounded-[0.5rem] px-4 py-2 text-center text-sm font-semibold transition-colors"
            >
              Create your first handout
            </a>
          </>
        ) : listKind === 'published' ? (
          <p class="text-muted-foreground">No published handouts.</p>
        ) : (
          <p class="text-muted-foreground">No archived handouts.</p>
        )
      }
    </div>
    <p class="text-muted-foreground" data-handout-type-empty>No handouts of this type.</p>
    <p class="text-muted-foreground" data-handout-search-empty>No handouts match this search.</p>
  </div>
</section>

<style>
  [data-handout-grid]:has(article) + [data-handout-empty] {
    display: none;
  }

  [data-handout-type-empty] {
    display: none;
  }

  /* :has() targets HandoutCard articles, which this template does not contain. */
  [data-handout-grid]:global(
      :has([data-handout-card][data-type-hidden]):not(:has([data-handout-card]:not([data-type-hidden])))
    )
    ~ [data-handout-type-empty] {
    display: block;
  }

  [data-handout-search-empty] {
    display: none;
  }

  [data-handout-grid]:global(
      :has([data-handout-card][data-search-hidden]:not([data-type-hidden])):not(
        :has([data-handout-card]:not([data-type-hidden]):not([data-search-hidden]))
      )
    )
    ~ [data-handout-search-empty] {
    display: block;
  }
</style>
