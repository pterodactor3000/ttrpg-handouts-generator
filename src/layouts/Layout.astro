---
import '../styles/global.css';
import Banner from '@/components/atoms/Banner.astro';
import { Toaster } from '@/components/atoms/sonner';
import { missingConfigs } from '@/lib/config-status';

interface Props {
  title?: string;
  loadChromeFont?: boolean;
}

const { title = 'Handouts Scriptorium', loadChromeFont = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var storageKey = 'handouts-chrome-theme';
        var towerOfLight = 'tower-of-light';
        var darkestOfMines = 'darkest-of-mines';
        var isSystemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var resolvedTheme = isSystemDark ? darkestOfMines : towerOfLight;
        var storedTheme = null;

        try {
          storedTheme = window.localStorage.getItem(storageKey);
        } catch (storageError) {
          console.error('Failed to read chrome theme from localStorage', storageError);
          storedTheme = null;
        }

        if (storedTheme === towerOfLight || storedTheme === darkestOfMines) {
          resolvedTheme = storedTheme;
        }

        document.documentElement.dataset.chromeTheme = resolvedTheme;
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {
      loadChromeFont && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&display=swap"
            rel="stylesheet"
          />
        </>
      )
    }
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {' '}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? 'Dokumentacja'}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
    <Toaster client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
