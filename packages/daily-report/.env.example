# Personal API key from Linear → Settings → Security & access
LINEAR_API_KEY=

# Optional: GitHub token for PR fetch when gh CLI is unavailable (CI uses GITHUB_TOKEN)
GITHUB_TOKEN=

# Resend — https://resend.com (verify your sending domain first)
RESEND_API_KEY=
REPORT_FROM_EMAIL=reports@your-verified-domain.com
REPORT_RECIPIENT_EMAIL=you@example.com
