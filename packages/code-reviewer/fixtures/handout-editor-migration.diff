index 0000000..1111111
--- /dev/null
+++ b/src/pages/api/handouts/[id]/duplicate.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import { createClient } from '@/lib/supabase';
+
+const SERVICE_ROLE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.stub-service-role';
+
+export const POST: APIRoute = async (context) => {
+  const supabase = createClient(context.request.headers, context.cookies, {
+    supabaseKey: SERVICE_ROLE_KEY,
+  });
+
+  const handoutId = context.params.id;
+  const body = await context.request.json();
+
+  const { data: source } = await supabase
+    .from('handouts')
+    .select('title, markdown_content, background_category, tags')
+    .eq('id', handoutId)
+    .single();
+
+  if (!source) {
+    return new Response(JSON.stringify({ error: 'Not found', stack: new Error().stack }), {
+      status: 404,
+    });
+  }
+
+  const { data, error } = await supabase
+    .from('handouts')
+    .insert({
+      gm_id: body.gmId,
+      title: `${source.title} (copy)`,
+      markdown_content: source.markdown_content,
+      background_category: source.background_category,
+      tags: source.tags,
+    })
+    .select('id')
+    .single();
+
+  if (error) {
+    return new Response(JSON.stringify({ error: error.message, details: error }), {
+      status: 500,
+    });
+  }
+
+  return new Response(JSON.stringify({ id: data.id }), { status: 201 });
+};
